@args (String title, String name, String micronautDocumentation, String thirdPartyDocumentation)

@if (micronautDocumentation != null || thirdPartyDocumentation != null) {

## Feature @name documentation

    @if (micronautDocumentation != null) {

- [Micronaut @title.replaceFirst("^Micronaut\\s+(.*)", "$1") documentation](@micronautDocumentation)

    }
    @if (thirdPartyDocumentation != null) {

- [@thirdPartyDocumentation](@thirdPartyDocumentation)

    }
}
