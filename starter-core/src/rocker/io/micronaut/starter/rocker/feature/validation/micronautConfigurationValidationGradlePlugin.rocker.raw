@if(configurationValidation.suppressions() != null && !configurationValidation.suppressions().isEmpty()) {
@if (dsl == GradleDsl.KOTLIN) {
        suppressions.set(listOf(@for (int i = 0; i < configurationValidation.suppressions().size(); i++) {"@(configurationValidation.suppressions().get(i))"@if (i < (configurationValidation.suppressions().size() -1)) {, }}))
} else {
        suppressions.set([@for (int i = 0; i < configurationValidation.suppressions().size(); i++) {"@(configurationValidation.suppressions().get(i))"@if (i < (configurationValidation.suppressions().size() -1)) {, }}])
