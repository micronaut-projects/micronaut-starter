@import io.micronaut.starter.application.Project
@import io.micronaut.starter.build.gradle.GradleDsl
@args (GradleDsl dsl, Project project)
@if(dsl == GradleDsl.KOTLIN) {
tasks.withType<JavaCompile>().configureEach {
    options.errorprone.check("NullAway", net.ltgt.gradle.errorprone.CheckSeverity.ERROR)
    options.errorprone.option("NullAway:AnnotatedPackages", "@(project.getPackageName())")
    if (name.lowercase().contains("test")) {
        options.errorprone.disable("NullAway")
    }
}
} else {
tasks.withType(JavaCompile) {
    options.errorprone.check("NullAway", net.ltgt.gradle.errorprone.CheckSeverity.ERROR)
    options.errorprone.option("NullAway:AnnotatedPackages", "@(project.getPackageName())")
    if (name.toLowerCase().contains("test")) {
        options.errorprone.disable("NullAway")
    }
}
}