@option discardLogicWhitespace=true
@args (boolean jansi, boolean coloring, boolean jul, boolean stderr)

<configuration>

@if(jul){
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator"/>
}
    <appender name="@(stderr ? "STDERR" : "STDOUT")" class="ch.qos.logback.core.ConsoleAppender">
@if(stderr) {
        <target>System.err</target>
}
@if(jansi) {
        <withJansi>@jansi</withJansi>
}
        <!-- encoders are assigned the type
             ch.qos.logback.classic.encoder.PatternLayoutEncoder by default -->
        <encoder>
@if(coloring) {
            <pattern>%cyan(%d{HH:mm:ss.SSS}) %gray([%thread]) %highlight(%-5level) %magenta(%logger{36}) - %msg%n</pattern>
} else {
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
}
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="@(stderr ? "STDERR" : "STDOUT")" />
    </root>
</configuration>
